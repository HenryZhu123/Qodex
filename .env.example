# 在仓库根目录复制本文件并将副本命名为 .env.local，再填入自己的 API Key。
# Copy this file to .env.local in the repository root and fill in your own API keys.
# PowerShell: Copy-Item .env.example .env.local
# Bash: cp .env.example .env.local
# 已有 .env.local 时，请手动合并所需配置。修改后重启本地工作台。
# If .env.local already exists, merge the settings you need and restart the local stack.

# Pi 工作台 / Pi workbench (DeepSeek)
PI_PROVIDER=deepseek
PI_MODEL_ID=deepseek-flash
DEEPSEEK_API_KEY=

# 审校语言模型 / Exam-checker language model (DeepSeek)
EXAM_CHECKER_LLM_BASE_URL=https://api.deepseek.com
EXAM_CHECKER_LLM_MODEL=deepseek-flash
EXAM_CHECKER_LLM_API_KEY=

# 审校路由 / Exam-checker routing (AIHubMix SystemOne)
# EXAM_CHECKER_JEV_API_KEY 填入 AIHubMix 提供的 API Key。
# Set EXAM_CHECKER_JEV_API_KEY to your AIHubMix API key.
EXAM_CHECKER_JEV_ENDPOINT=https://aihubmix.com/v1/systemone
EXAM_CHECKER_JEV_MODEL=jev-1.14
EXAM_CHECKER_JEV_API_KEY=
