# Copy this file to .env.local. Never commit the real .env.local file.

# Qwen specialist reviewer (OpenAI-compatible Chat Completions API).
# The client calls: POST {EXAM_CHECKER_REVIEW_LLM_BASE_URL}/chat/completions
EXAM_CHECKER_REVIEW_LLM_BASE_URL=https://llm.talkweb.com.cn/v1
EXAM_CHECKER_REVIEW_LLM_API_KEY=
EXAM_CHECKER_REVIEW_LLM_MODEL=gpu-qwen3.8-27b
EXAM_CHECKER_REVIEW_LLM_TIMEOUT_SECONDS=180
EXAM_CHECKER_REVIEW_LLM_MAX_CONCURRENCY=8
EXAM_CHECKER_REVIEW_LLM_MAX_ATTEMPTS=3

# Jev routing relay (OpenRouter Decisions-compatible response schema).
# Exact relay endpoint takes precedence over BASE_URL + /decisions.
EXAM_CHECKER_JEV_ENDPOINT=
EXAM_CHECKER_JEV_BASE_URL=
EXAM_CHECKER_JEV_API_KEY=
EXAM_CHECKER_JEV_MODEL=typesafe/jev-1.13
EXAM_CHECKER_JEV_TIMEOUT_SECONDS=30
EXAM_CHECKER_JEV_MAX_CONCURRENCY=8
# Subject guard profile for deterministic factual checks.
# Empty means model-only factual review, which is the neutral default.
# Set to computer_science to enable the 408 rule profile shipped in
# src/exam_checker/parsing/guards/.
EXAM_CHECKER_GUARD_PROFILE=
