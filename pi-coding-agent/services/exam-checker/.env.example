EXAM_CHECKER_HOST=127.0.0.1
EXAM_CHECKER_PORT=8091

# Local PostgreSQL container started by ./start-exam-checker-db.sh.
# Change these together when overriding the local development credentials.
EXAM_CHECKER_POSTGRES_USER=qodex
EXAM_CHECKER_POSTGRES_PASSWORD=qodex-local
EXAM_CHECKER_POSTGRES_DB=qodex
EXAM_CHECKER_POSTGRES_PORT=5433
EXAM_CHECKER_DATABASE_URL=postgresql+asyncpg://qodex:qodex-local@127.0.0.1:5433/qodex

MINERU_AGENT_BASE_URL=https://mineru.net/api/v1/agent
MINERU_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_MAX_RETRIES=4

# OpenAI-compatible endpoint used only for Markdown -> exam tree extraction.
EXAM_CHECKER_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXAM_CHECKER_LLM_API_KEY=
EXAM_CHECKER_LLM_MODEL=qwen3.5-27b
EXAM_CHECKER_LLM_TIMEOUT_SECONDS=180

# OpenAI-compatible Qwen endpoint used by the nine specialist reviewers.
# These fall back to the extraction endpoint values when omitted.
EXAM_CHECKER_REVIEW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXAM_CHECKER_REVIEW_LLM_API_KEY=
EXAM_CHECKER_REVIEW_LLM_MODEL=qwen3.8-27b
EXAM_CHECKER_REVIEW_LLM_TIMEOUT_SECONDS=180
EXAM_CHECKER_REVIEW_LLM_MAX_CONCURRENCY=8
EXAM_CHECKER_REVIEW_LLM_MAX_ATTEMPTS=3
# Reasoning models on some relays ignore enable_thinking and spend max_tokens on
# reasoning_content, truncating the JSON answer. Set to "none" to disable it.
# Leave empty for models that do not support the field.
EXAM_CHECKER_REVIEW_REASONING_EFFORT=
# Output budget per specialist call. Raise it for reasoning models or for tasks
# whose JSON answer is long; the compact-JSON repair call uses the same value.
EXAM_CHECKER_REVIEW_MAX_TOKENS=2048
# Optional prompt used by the KB-enabled logic specialist. Keep empty to use
# the packaged logic-check prompt.
EXAM_CHECKER_AGENTIC_LOGIC_PROMPT_PATH=

# Local Dev A evaluation currently uses the TalkWeb OpenAI-compatible endpoint.
# The reviewer sends POST requests to {BASE_URL}/chat/completions.
# EXAM_CHECKER_REVIEW_LLM_BASE_URL=https://llm.talkweb.com.cn/v1
# EXAM_CHECKER_REVIEW_LLM_MODEL=gpu-qwen3.8-27b

# OpenRouter Decisions API used by the three locked Jev gates.
EXAM_CHECKER_JEV_BASE_URL=https://openrouter.ai/api/alpha
# Optional exact endpoint for relays. When set, it is used as-is and BASE_URL
# is not suffixed with /decisions.
EXAM_CHECKER_JEV_ENDPOINT=
EXAM_CHECKER_JEV_API_KEY=
EXAM_CHECKER_JEV_MODEL=typesafe/jev-1.13
EXAM_CHECKER_JEV_TIMEOUT_SECONDS=30
EXAM_CHECKER_JEV_MAX_CONCURRENCY=8

# For OpenRouter, the client sends POST {BASE_URL}/decisions. For a relay with
# a complete SystemOne URL, set EXAM_CHECKER_JEV_ENDPOINT instead.

# OpenAI-compatible model used for question revision and metadata annotation.
# These fall back to the extraction model settings when omitted.
EXAM_CHECKER_WORKFLOW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXAM_CHECKER_WORKFLOW_LLM_API_KEY=
EXAM_CHECKER_WORKFLOW_LLM_MODEL=qwen3.5-27b
EXAM_CHECKER_WORKFLOW_LLM_TIMEOUT_SECONDS=180
EXAM_CHECKER_WORKFLOW_LLM_MAX_CONCURRENCY=8

