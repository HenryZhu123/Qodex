# Optional. Defaults to the qodex-web package directory.
PI_WORKSPACE_PATH=/absolute/path/to/a/scratch/workspace

# Optional. Defaults to ~/.pi/agent.
# PI_CODING_AGENT_DIR=/absolute/path/to/pi/agent

# Qodex tool services. These defaults match the local startup documentation.
EXAM_CHECKER_SERVICE_URL=http://127.0.0.1:8091
EXAM_ASSEMBLY_SERVICE_URL=http://127.0.0.1:8092
QUESTION_GENERATION_SERVICE_URL=http://127.0.0.1:8093
