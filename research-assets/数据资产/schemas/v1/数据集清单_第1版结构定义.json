{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hyt-agent:schema:dataset-manifest:v1",
  "title": "DatasetManifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "created_at",
    "lifecycle_status",
    "parent_dataset_ids",
    "snapshot_id",
    "source_manifest_ref",
    "task_catalog_ref",
    "prompt_profile_id",
    "current_format",
    "target_sample_schema",
    "record_count",
    "source_ids",
    "category_counts",
    "task_counts",
    "data_quality",
    "split",
    "canonicalization_status",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"const": "DatasetManifest.v1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{4,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "lifecycle_status": {
      "type": "string",
      "enum": ["frozen_pre_migration", "canonicalized", "split_frozen", "retired"]
    },
    "parent_dataset_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "snapshot_id": {"type": "string", "minLength": 1},
    "source_manifest_ref": {"type": "string", "minLength": 1},
    "task_catalog_ref": {"type": "string", "minLength": 1},
    "prompt_profile_id": {
      "type": "string",
      "enum": ["original", "tuned"]
    },
    "current_format": {"const": "messages_jsonl"},
    "target_sample_schema": {"const": "CanonicalSample.v3-lite"},
    "assistant_output_schema_ref": {"type": "string", "minLength": 1},
    "message_roles": {
      "type": "array",
      "prefixItems": [
        {"const": "system"},
        {"const": "user"},
        {"const": "assistant"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "record_count": {"type": "integer", "minimum": 0},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^src_[a-f0-9]{24}$"}
    },
    "category_counts": {"$ref": "#/$defs/count_map"},
    "task_counts": {"$ref": "#/$defs/count_map"},
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_type_mismatch_rows",
        "error_type_mismatch_findings",
        "error_type_mismatch_examples"
      ],
      "properties": {
        "error_type_mismatch_rows": {"type": "integer", "minimum": 0},
        "error_type_mismatch_findings": {"type": "integer", "minimum": 0},
        "error_type_mismatch_examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_category",
              "source_file",
              "source_row",
              "task_id",
              "expected_error_type",
              "actual_error_type"
            ],
            "properties": {
              "dataset_category": {"type": "string", "minLength": 1},
              "source_file": {"type": "string", "minLength": 1},
              "source_row": {"type": "integer", "minimum": 1},
              "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
              "expected_error_type": {"type": "string", "minLength": 1},
              "actual_error_type": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "split_policy_version", "counts"],
      "properties": {
        "applied": {"type": "boolean"},
        "split_policy_version": {"type": "string", "minLength": 1},
        "counts": {"$ref": "#/$defs/count_map"}
      }
    },
    "canonicalization_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "completed"]
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_category", "task_id", "count", "reason"],
        "properties": {
          "dataset_category": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "count": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "count_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
