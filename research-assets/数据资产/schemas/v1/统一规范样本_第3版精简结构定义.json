{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hyt-agent:schema:canonical-sample:v3-lite",
  "title": "CanonicalSample.v3-lite",
  "description": "试题审校项目的精简统一规范样本。保存可追溯事实和标准标注，不保存完整提示词、训练运行参数或审计事件。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "lineage_id",
    "lineage_status",
    "source_ref",
    "question",
    "annotation",
    "split"
  ],
  "properties": {
    "schema_version": {
      "const": "CanonicalSample.v3-lite"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^cs_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$",
      "description": "当前题目、任务和来源组合的稳定唯一标识。"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^ln_[A-Za-z0-9][A-Za-z0-9._-]{7,127}$",
      "description": "同一道原题及其改写、注错、跨任务变体共享的血缘标识。"
    },
    "lineage_status": {
      "type": "string",
      "enum": [
        "verified",
        "provisional",
        "needs_review"
      ],
      "description": "血缘关系的可信状态；无法确认时必须使用 needs_review。"
    },
    "source_ref": {
      "$ref": "#/$defs/source_ref"
    },
    "question": {
      "$ref": "#/$defs/question"
    },
    "annotation": {
      "$ref": "#/$defs/annotation"
    },
    "split": {
      "type": "string",
      "enum": [
        "unassigned",
        "train",
        "dev",
        "test",
        "shadow_holdout"
      ],
      "description": "数据切分结果。血缘切分前使用 unassigned。"
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_row"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src_[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "source_row": {
          "type": "integer",
          "minimum": 1,
          "description": "原始文件中的一基行号。"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_payload"
      ],
      "properties": {
        "input_payload": {
          "$ref": "#/$defs/input_payload"
        },
        "metadata": {
          "$ref": "#/$defs/question_metadata"
        },
        "attachment_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "input_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "detection_content"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "description": "生产请求中的参考信息，只用于理解题型和语境。"
        },
        "detection_content": {
          "type": "string",
          "minLength": 1,
          "description": "生产请求中唯一的审校对象，必须原样保存。"
        }
      }
    },
    "question_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "question_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "rubric_version",
        "scope",
        "status",
        "gold"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "$ref": "#/$defs/annotation_scope"
        },
        "status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "auto_validated",
            "codex_reviewed",
            "human_reviewed",
            "adjudicated",
            "rejected"
          ]
        },
        "gold": {
          "$ref": "#/$defs/gold"
        }
      }
    },
    "annotation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotated_task_ids",
        "unannotated_task_ids_are_negative"
      ],
      "properties": {
        "annotated_task_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          }
        },
        "unannotated_task_ids_are_negative": {
          "type": "boolean"
        }
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "has_error",
        "total_errors",
        "errors"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "has_error": {
          "type": "boolean"
        },
        "total_errors": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gold_error"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "has_error": {
                "const": true
              }
            },
            "required": [
              "has_error"
            ]
          },
          "then": {
            "properties": {
              "total_errors": {
                "minimum": 1
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "has_error": {
                "const": false
              }
            },
            "required": [
              "has_error"
            ]
          },
          "then": {
            "properties": {
              "total_errors": {
                "const": 0
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "gold_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_type",
        "position",
        "original_text",
        "anchor_text",
        "correction",
        "description",
        "suggestion"
      ],
      "properties": {
        "error_type": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "original_text": {
          "type": "string",
          "description": "最短连续原文；纯缺失错误允许为空字符串。"
        },
        "anchor_text": {
          "type": "string",
          "minLength": 1
        },
        "correction": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "suggestion": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
